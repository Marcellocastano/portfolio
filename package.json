{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && eslint . && tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "16.32.0",
    "three": "0.173.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.173.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "prettier": "3.9.8",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vite": "5.4.21"
  }
}
