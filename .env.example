# URL pubblico del sito, senza slash finale. Usato per canonical, Open Graph, sitemap e robots.txt.
# Copialo in .env (o impostalo nelle variabili d'ambiente dell'hosting) prima del deploy.
VITE_SITE_URL=https://www.dominio.it

# Facoltativi: codici di verifica di Google Search Console e Bing Webmaster Tools (meta tag).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
